$PBExportHeader$d_order_list.srd
$PBExportComments$Order List DataWindow — uses v_order_summary view

release 19;
datawindow(units=0 timer_interval=0 color=1073741824 processing=0 HTMLDW=no print.margin.left=227 print.margin.right=227 print.margin.top=227 print.margin.bottom=227 print.orientation=0)

table(column=(type=long name=order_id dbname="order_id" )
column=(type=date name=order_date dbname="order_date" )
column=(type=char(20) name=status dbname="status" )
column=(type=long name=customer_id dbname="customer_id" )
column=(type=char(100) name=company_name dbname="company_name" )
column=(type=char(100) name=contact_name dbname="contact_name" )
column=(type=decimal name=order_total dbname="order_total" )
column=(type=long name=item_count dbname="item_count" )
column=(type=date name=required_date dbname="required_date" )
retrieve="SELECT order_id, order_date, status, customer_id, company_name, contact_name, order_total, item_count, required_date FROM v_order_summary ORDER BY order_date DESC, order_id DESC"
update="orders"
updateable=no
)

data()

header(height=260 color=536870912)
detail(height=260 color=1073741824)
summary(height=0 color=1073741824)
footer(height=0 color=1073741824)

// Headers
text(band=header text="Order #" font.face="Segoe UI" font.height=-10 font.weight=700 x=0 y=0 width=540 height=260 color=16777215 background.color=4210752)
text(band=header text="Date" font.face="Segoe UI" font.height=-10 font.weight=700 x=540 y=0 width=700 height=260 color=16777215 background.color=4210752)
text(band=header text="Status" font.face="Segoe UI" font.height=-10 font.weight=700 x=1240 y=0 width=840 height=260 color=16777215 background.color=4210752)
text(band=header text="Customer" font.face="Segoe UI" font.height=-10 font.weight=700 x=2080 y=0 width=2000 height=260 color=16777215 background.color=4210752)
text(band=header text="Items" font.face="Segoe UI" font.height=-10 font.weight=700 x=4080 y=0 width=400 height=260 color=16777215 background.color=4210752)
text(band=header text="Order Total" font.face="Segoe UI" font.height=-10 font.weight=700 x=4480 y=0 width=1000 height=260 color=16777215 background.color=4210752)
text(band=header text="Required By" font.face="Segoe UI" font.height=-10 font.weight=700 x=5480 y=0 width=700 height=260 color=16777215 background.color=4210752)

// Columns
column(band=detail id=1 alignment="2" x=0 y=0 width=540 height=260 name=order_id font.face="Segoe UI" font.height=-10 border=1 format="[general]")
column(band=detail id=2 alignment="0" x=540 y=0 width=700 height=260 name=order_date font.face="Segoe UI" font.height=-10 border=1 format="mm/dd/yyyy")
column(band=detail id=3 alignment="0" x=1240 y=0 width=840 height=260 name=status font.face="Segoe UI" font.height=-10 border=1)
column(band=detail id=4 alignment="0" x=2080 y=0 width=2000 height=260 name=company_name font.face="Segoe UI" font.height=-10 border=1)
column(band=detail id=5 alignment="2" x=4080 y=0 width=400 height=260 name=item_count font.face="Segoe UI" font.height=-10 border=1 format="[general]")
column(band=detail id=6 alignment="2" x=4480 y=0 width=1000 height=260 name=order_total font.face="Segoe UI" font.height=-10 border=1 format="$#,##0.00")
column(band=detail id=7 alignment="0" x=5480 y=0 width=700 height=260 name=required_date font.face="Segoe UI" font.height=-10 border=1 format="mm/dd/yyyy")

// Colour the status column using expression background
// PENDING=yellow, CONFIRMED=light-blue, SHIPPED=light-green, DELIVERED=white, CANCELLED=light-red
