$PBExportHeader$d_report_order_history.srd
$PBExportComments$Report DataWindow — Order History by Customer (grouped)

release 19;
datawindow(units=0 timer_interval=0 color=16777215 processing=0 print.orientation=0 print.paper.size=1)

table(column=(type=char(100) name=company_name dbname="company_name")
column=(type=long name=order_id dbname="order_id")
column=(type=date name=order_date dbname="order_date")
column=(type=char(20) name=status dbname="status")
column=(type=decimal name=order_total dbname="order_total")
column=(type=long name=item_count dbname="item_count")
retrieve="SELECT company_name, order_id, order_date, status, order_total, item_count FROM v_order_summary WHERE order_date BETWEEN :ad_from AND :ad_to ORDER BY company_name, order_date"
arguments=(("ad_from", date), ("ad_to", date))
update="orders"
updateable=no
)

data()

group(level=1 by=(company_name) newpage=no )

header(height=560 color=16777215)
detail(height=260 color=16777215)
summary(height=440 color=16777215)
footer(height=260 color=16777215)

// Page header — title band
text(band=header text="Order History Report" alignment="1" font.face="Segoe UI" font.height=-16 font.weight=700 x=0 y=40 width=7200 height=340 color=0)
text(band=header text="Generated: " alignment="2" font.face="Segoe UI" font.height=-9 x=5200 y=380 width=800 height=180 color=8421504)
compute(band=header expression="Today()" format="mm/dd/yyyy" alignment="0" font.face="Segoe UI" font.height=-9 x=6000 y=380 width=1000 height=180 color=8421504 name=c_today)

// Group header — customer name
text(band=header[1] text="" font.face="Segoe UI" font.height=-11 font.weight=700 x=0 y=40 width=200 height=220 color=0)
column(band=header[1] id=99 expression="company_name" font.face="Segoe UI" font.height=-11 font.weight=700 x=0 y=40 width=3000 height=220 color=0 name=c_grp_company)

// Column headers within group
text(band=header[1] text="Order #" font.face="Segoe UI" font.height=-9 font.weight=700 x=200 y=280 width=600 height=200 background.color=13421772)
text(band=header[1] text="Date" font.face="Segoe UI" font.height=-9 font.weight=700 x=800 y=280 width=700 height=200 background.color=13421772)
text(band=header[1] text="Status" font.face="Segoe UI" font.height=-9 font.weight=700 x=1500 y=280 width=800 height=200 background.color=13421772)
text(band=header[1] text="Items" font.face="Segoe UI" font.height=-9 font.weight=700 x=2300 y=280 width=500 height=200 background.color=13421772)
text(band=header[1] text="Order Total" alignment="2" font.face="Segoe UI" font.height=-9 font.weight=700 x=2800 y=280 width=1000 height=200 background.color=13421772)

// Detail
column(band=detail id=1 alignment="2" x=200 y=0 width=600 height=260 name=order_id font.face="Segoe UI" font.height=-9 border=1 format="[general]")
column(band=detail id=2 x=800 y=0 width=700 height=260 name=order_date font.face="Segoe UI" font.height=-9 border=1 format="mm/dd/yyyy")
column(band=detail id=3 x=1500 y=0 width=800 height=260 name=status font.face="Segoe UI" font.height=-9 border=1)
column(band=detail id=4 alignment="2" x=2300 y=0 width=500 height=260 name=item_count font.face="Segoe UI" font.height=-9 border=1 format="[general]")
column(band=detail id=5 alignment="2" x=2800 y=0 width=1000 height=260 name=order_total font.face="Segoe UI" font.height=-9 border=1 format="$#,##0.00")

// Group trailer — customer subtotal
text(band=trailer[1] text="Customer Total:" alignment="2" font.face="Segoe UI" font.height=-9 font.weight=700 x=1800 y=20 width=1000 height=220 color=0)
compute(band=trailer[1] expression="sum(order_total for group 1)" format="$#,##0.00" alignment="2" font.face="Segoe UI" font.height=-9 font.weight=700 x=2800 y=20 width=1000 height=220 color=0 name=c_grp_total)

// Report summary
text(band=summary text="GRAND TOTAL:" alignment="2" font.face="Segoe UI" font.height=-11 font.weight=700 x=1800 y=80 width=1000 height=280 color=0)
compute(band=summary expression="sum(order_total)" format="$#,##0.00" alignment="2" font.face="Segoe UI" font.height=-11 font.weight=700 x=2800 y=80 width=1000 height=280 color=0 name=c_grand_total)

// Page footer
compute(band=footer expression="'Page ' + String(Page()) + ' of ' + String(PageCount())" alignment="2" font.face="Segoe UI" font.height=-9 x=5800 y=20 width=1400 height=220 color=8421504 name=c_page)


$PBExportHeader$d_report_inventory.srd
$PBExportComments$Report DataWindow — Inventory Status by Category (grouped)

release 19;
datawindow(units=0 timer_interval=0 color=16777215 processing=0 print.orientation=0 print.paper.size=1)

table(column=(type=char(80) name=category_name dbname="category_name")
column=(type=char(30) name=product_code dbname="product_code")
column=(type=char(150) name=product_name dbname="product_name")
column=(type=decimal name=unit_price dbname="unit_price")
column=(type=long name=stock_qty dbname="stock_qty")
column=(type=long name=reorder_level dbname="reorder_level")
column=(type=char(20) name=unit_of_measure dbname="unit_of_measure")
retrieve="SELECT pc.category_name, p.product_code, p.product_name, p.unit_price, p.stock_qty, p.reorder_level, p.unit_of_measure FROM products p LEFT JOIN product_categories pc ON pc.category_id = p.category_id WHERE p.is_active = 1 ORDER BY pc.category_name, p.product_name"
update="products"
updateable=no
)

data()

group(level=1 by=(category_name) newpage=no)

header(height=480 color=16777215)
detail(height=260 color=16777215)
summary(height=380 color=16777215)
footer(height=260 color=16777215)

text(band=header text="Inventory Status Report" alignment="1" font.face="Segoe UI" font.height=-16 font.weight=700 x=0 y=40 width=7200 height=340 color=0)
compute(band=header expression="Today()" format="'As of 'mmm dd, yyyy" alignment="1" font.face="Segoe UI" font.height=-9 x=0 y=380 width=7200 height=200 color=8421504 name=c_date)

// Group header
column(band=header[1] id=88 expression="Upper(category_name)" font.face="Segoe UI" font.height=-11 font.weight=700 x=0 y=40 width=2400 height=220 color=0 name=c_cat_label background.color=13421772)
text(band=header[1] text="Code" font.face="Segoe UI" font.height=-9 font.weight=700 x=0 y=280 width=600 height=200 background.color=15132390)
text(band=header[1] text="Product Name" font.face="Segoe UI" font.height=-9 font.weight=700 x=600 y=280 width=2200 height=200 background.color=15132390)
text(band=header[1] text="Price" alignment="2" font.face="Segoe UI" font.height=-9 font.weight=700 x=2800 y=280 width=800 height=200 background.color=15132390)
text(band=header[1] text="On Hand" alignment="2" font.face="Segoe UI" font.height=-9 font.weight=700 x=3600 y=280 width=600 height=200 background.color=15132390)
text(band=header[1] text="Reorder" alignment="2" font.face="Segoe UI" font.height=-9 font.weight=700 x=4200 y=280 width=600 height=200 background.color=15132390)
text(band=header[1] text="UOM" font.face="Segoe UI" font.height=-9 font.weight=700 x=4800 y=280 width=500 height=200 background.color=15132390)
text(band=header[1] text="Status" font.face="Segoe UI" font.height=-9 font.weight=700 x=5300 y=280 width=800 height=200 background.color=15132390)

// Detail
column(band=detail id=1 x=0 y=0 width=600 height=260 name=product_code font.face="Segoe UI" font.height=-9 border=1)
column(band=detail id=2 x=600 y=0 width=2200 height=260 name=product_name font.face="Segoe UI" font.height=-9 border=1)
column(band=detail id=3 alignment="2" x=2800 y=0 width=800 height=260 name=unit_price font.face="Segoe UI" font.height=-9 border=1 format="$#,##0.00")
column(band=detail id=4 alignment="2" x=3600 y=0 width=600 height=260 name=stock_qty font.face="Segoe UI" font.height=-9 border=1 format="[general]"
  background.expression="If(stock_qty = 0, RGB(255,200,200), If(stock_qty <= reorder_level, RGB(255,240,200), 16777215))")
column(band=detail id=5 alignment="2" x=4200 y=0 width=600 height=260 name=reorder_level font.face="Segoe UI" font.height=-9 border=1 format="[general]")
column(band=detail id=6 x=4800 y=0 width=500 height=260 name=unit_of_measure font.face="Segoe UI" font.height=-9 border=1)
compute(band=detail id=7 expression="If(stock_qty = 0, 'OUT OF STOCK', If(stock_qty <= reorder_level, 'LOW', 'OK'))" x=5300 y=0 width=800 height=260 font.face="Segoe UI" font.height=-9 border=1 name=c_status_label
  color.expression="If(stock_qty = 0, RGB(200,0,0), If(stock_qty <= reorder_level, RGB(180,100,0), RGB(0,140,0)))")

// Summary
text(band=summary text="Total Products Listed:" alignment="2" font.face="Segoe UI" font.height=-9 font.weight=700 x=1800 y=80 width=1600 height=240 color=0)
compute(band=summary expression="Count(product_code)" alignment="2" font.face="Segoe UI" font.height=-9 font.weight=700 x=3400 y=80 width=400 height=240 color=0 name=c_count)
compute(band=footer expression="'Page ' + String(Page()) + ' of ' + String(PageCount())" alignment="2" font.face="Segoe UI" font.height=-9 x=5800 y=20 width=1400 height=220 color=8421504 name=c_page)
