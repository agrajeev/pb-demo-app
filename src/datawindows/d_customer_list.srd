$PBExportHeader$d_customer_list.srd
$PBExportComments$Customer List DataWindow — grid style

release 19;
datawindow(units=0 timer_interval=0 color=1073741824 processing=0 HTMLDW=no print.margin.left=227 print.margin.right=227 print.margin.top=227 print.margin.bottom=227 print.orientation = 0 print.color=1 print.prompt=no print.buttons=no)

table(column=(type=long updatewhere=1 name=customer_id dbname="customer_id" )
column=(type=char(100) updatewhere=1 name=company_name dbname="company_name" )
column=(type=char(100) updatewhere=1 name=contact_name dbname="contact_name" )
column=(type=char(30) updatewhere=1 name=phone dbname="phone" )
column=(type=char(100) updatewhere=1 name=email dbname="email" )
column=(type=char(80) updatewhere=1 name=city dbname="city" )
column=(type=char(50) updatewhere=1 name=state dbname="state" )
column=(type=decimal updatewhere=1 name=credit_limit dbname="credit_limit" )
column=(type=integer updatewhere=1 name=is_active dbname="is_active" )
retrieve="SELECT customer_id, company_name, contact_name, phone, email, city, state, credit_limit, is_active FROM customers ORDER BY company_name"
update="customers"
updateable=yes
tablename="customers"
key=("customer_id")
)

data()

header(height=260 color=536870912 )
summary(height=0 color=1073741824 )
footer(height=0 color=1073741824 )
detail(height=260 color=1073741824 )

text(band=header alignment="2" text="ID" font.face="Segoe UI" font.height=-10 font.weight=700 border=0 color=16777215 x=0 y=0 width=300 height=260 name=t_id background.color=4210752 )
text(band=header alignment="2" text="Company Name" font.face="Segoe UI" font.height=-10 font.weight=700 border=0 color=16777215 x=300 y=0 width=1800 height=260 name=t_company background.color=4210752 )
text(band=header alignment="2" text="Contact" font.face="Segoe UI" font.height=-10 font.weight=700 border=0 color=16777215 x=2100 y=0 width=1200 height=260 name=t_contact background.color=4210752 )
text(band=header alignment="2" text="Phone" font.face="Segoe UI" font.height=-10 font.weight=700 border=0 color=16777215 x=3300 y=0 width=900 height=260 name=t_phone background.color=4210752 )
text(band=header alignment="2" text="City" font.face="Segoe UI" font.height=-10 font.weight=700 border=0 color=16777215 x=4200 y=0 width=800 height=260 name=t_city background.color=4210752 )
text(band=header alignment="2" text="State" font.face="Segoe UI" font.height=-10 font.weight=700 border=0 color=16777215 x=5000 y=0 width=500 height=260 name=t_state background.color=4210752 )
text(band=header alignment="2" text="Credit Limit" font.face="Segoe UI" font.height=-10 font.weight=700 border=0 color=16777215 x=5500 y=0 width=900 height=260 name=t_credit background.color=4210752 )
text(band=header alignment="2" text="Active" font.face="Segoe UI" font.height=-10 font.weight=700 border=0 color=16777215 x=6400 y=0 width=400 height=260 name=t_active background.color=4210752 )

column(band=detail id=1 alignment="2" tabsequence=1 border=1 color=0 x=0 y=0 width=300 height=260 name=customer_id font.face="Segoe UI" font.height=-10 format="[general]" edit.limit=0 edit.autohscroll=yes)
column(band=detail id=2 alignment="0" tabsequence=2 border=1 color=0 x=300 y=0 width=1800 height=260 name=company_name font.face="Segoe UI" font.height=-10 edit.limit=100 edit.autohscroll=yes)
column(band=detail id=3 alignment="0" tabsequence=3 border=1 color=0 x=2100 y=0 width=1200 height=260 name=contact_name font.face="Segoe UI" font.height=-10 edit.limit=100 edit.autohscroll=yes)
column(band=detail id=4 alignment="0" tabsequence=4 border=1 color=0 x=3300 y=0 width=900 height=260 name=phone font.face="Segoe UI" font.height=-10 edit.limit=30 edit.autohscroll=yes)
column(band=detail id=5 alignment="0" tabsequence=5 border=1 color=0 x=4200 y=0 width=800 height=260 name=city font.face="Segoe UI" font.height=-10 edit.limit=80 edit.autohscroll=yes)
column(band=detail id=6 alignment="0" tabsequence=6 border=1 color=0 x=5000 y=0 width=500 height=260 name=state font.face="Segoe UI" font.height=-10 edit.limit=50 edit.autohscroll=yes)
column(band=detail id=7 alignment="2" tabsequence=7 border=1 color=0 x=5500 y=0 width=900 height=260 name=credit_limit font.face="Segoe UI" font.height=-10 format="$#,##0.00" edit.limit=0)
column(band=detail id=8 alignment="1" tabsequence=8 border=1 color=0 x=6400 y=0 width=400 height=260 name=is_active font.face="Segoe UI" font.height=-10 format="[general]" edit.style="checkbox" edit.text1="Yes" edit.textother="No" edit.on=1 edit.off=0)
