$PBExportHeader$m_main.srm
$PBExportComments$Main Application Menu — MDI Frame

release 19;

forward
global type m_main from menu
end type
end forward

global type m_main from menu
end type

type m_file from menu within m_main
  menuitem m_dashboard
  menuitem m_separator1
  menuitem m_logout
  menuitem m_exit
end type

type m_modules from menu within m_main
  menuitem m_customers
  menuitem m_products
  menuitem m_orders
  menuitem m_separator2
  menuitem m_reports
end type

type m_admin from menu within m_main
  menuitem m_users
  menuitem m_separator3
  menuitem m_about
end type

type m_window from menu within m_main
  menuitem m_cascade
  menuitem m_tile_horz
  menuitem m_tile_vert
  menuitem m_arrange_icons
end type

global m_main m_main

on m_main.create
this.m_file = create m_file
this.m_modules = create m_modules
this.m_admin = create m_admin
this.m_window = create m_window

this.AddItem (this.m_file)
this.AddItem (this.m_modules)
this.AddItem (this.m_admin)
this.AddItem (this.m_window)
end on

/* ── File Menu ── */
event clicked() for m_file.m_dashboard;
  w_main.TriggerEvent("ue_open_dashboard")
end event

event clicked() for m_file.m_logout;
  IF gf_confirm("Log out and return to login screen?", "Logout") THEN
    Close(w_main)
    DISCONNECT USING SQLCA;
    Open(w_login)
  END IF
end event

event clicked() for m_file.m_exit;
  w_main.TriggerEvent("close")
end event

/* ── Modules Menu ── */
event clicked() for m_modules.m_customers;
  w_main.TriggerEvent("ue_open_customers")
end event

event clicked() for m_modules.m_products;
  w_main.TriggerEvent("ue_open_products")
end event

event clicked() for m_modules.m_orders;
  w_main.TriggerEvent("ue_open_orders")
end event

event clicked() for m_modules.m_reports;
  w_main.TriggerEvent("ue_open_reports")
end event

/* ── Admin Menu ── */
event clicked() for m_admin.m_about;
  w_main.TriggerEvent("ue_about")
end event

/* ── Window Menu ── */
event clicked() for m_window.m_cascade;
  w_main.ArrangeSheets(Cascade!)
end event

event clicked() for m_window.m_tile_horz;
  w_main.ArrangeSheets(Tile!)
end event

event clicked() for m_window.m_tile_vert;
  w_main.ArrangeSheets(TileVertical!)
end event

event clicked() for m_window.m_arrange_icons;
  w_main.ArrangeSheets(Icons!)
end event

/* ── Menu Item Properties ── */
on m_file.create
  this.Text     = "&File"
  m_dashboard.Text = "&Dashboard"
  m_separator1.Text = "-"
  m_logout.Text = "&Logout"
  m_exit.Text   = "E&xit"
end on

on m_modules.create
  this.Text       = "&Modules"
  m_customers.Text = "&Customers"
  m_products.Text  = "&Products / Inventory"
  m_orders.Text    = "&Orders"
  m_separator2.Text = "-"
  m_reports.Text   = "&Reports"
end on

on m_admin.create
  this.Text    = "&Admin"
  m_users.Text = "&User Management"
  m_separator3.Text = "-"
  m_about.Text = "&About PBDemo"
end on

on m_window.create
  this.Text            = "&Window"
  m_cascade.Text       = "&Cascade"
  m_tile_horz.Text     = "Tile &Horizontal"
  m_tile_vert.Text     = "Tile &Vertical"
  m_arrange_icons.Text = "&Arrange Icons"
end on
